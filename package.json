{
  "name": "w3r",
  "version": "1.4.0",
  "description": "Visualizzatore e stampa di file Markdown per Windows (Neutralinojs)",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js && neu update",
    "dev": "neu run",
    "test": "node --test \"tests/**/*.test.js\"",
    "build": "neu build --embed-resources --clean",
    "installer": "npm run build && node scripts/installer.js",
    "package": "npm run build && node scripts/package.js",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@neutralinojs/neu": "^11.7.2",
    "dompurify": "^3.4.16",
    "github-markdown-css": "^5.9.0",
    "katex": "^0.19.1",
    "marked": "^18.0.14",
    "marked-footnote": "^1.4.0",
    "mermaid": "^11.17.2",
    "png2icons": "^2.0.1"
  }
}

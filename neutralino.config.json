{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "eu.w3r.app",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.showOpenDialog",
    "os.showMessageBox",
    "os.open",
    "server.mount",
    "server.unmount",
    "filesystem.readFile",
    "window.setTitle",
    "os.getPath",
    "filesystem.writeFile",
    "filesystem.createDirectory",
    "window.getPosition",
    "window.move",
    "filesystem.readDirectory",
    "filesystem.remove"
  ],
  "modes": {
    "window": {
      "title": "w3r",
      "width": 960,
      "height": 800,
      "minWidth": 400,
      "minHeight": 300,
      "enableInspector": false,
      "exitProcessOnClose": false,
      "icon": "/resources/icons/app.png",
      "center": true
    }
  },
  "cli": {
    "binaryName": "w3r",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  },
  "applicationName": "w3r",
  "description": "Visualizzatore e stampa di file Markdown"
}
